<?xml version="1.0" encoding="utf-8"?>
<!-- Progress never goes to cloud backup. Moving to a new phone with the phone's own cable or
     Wi-Fi transfer still carries it, which the user starts themselves. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
